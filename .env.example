# ============================================
# 个人知识库系统 - 环境变量配置示例
# ============================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 修改下方配置项的值
# 3. 启动服务: python start.py
# ============================================

# ============================================
# 应用配置
# ============================================
APP_NAME="个人知识库系统"
APP_VERSION="0.1.4"
DEBUG=false

# ============================================
# Qdrant 向量数据库配置
# ============================================
QDRANT_HOST="localhost"
QDRANT_PORT=6334
QDRANT_COLLECTION_NAME="central_library"
QDRANT_API_KEY=""
QDRANT_DEFAULT_LIMIT=5

# Qdrant数据存储目录（可选：未设置时自动使用 ./qdrant_data）
# QDRANT_DATA_DIR="./qdrant_data"

# ============================================
# JWT 认证配置
# ============================================
# 重要：生产环境必须修改为强密钥！
SECRET_KEY="your-secret-key-here-please-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# 文件上传配置
# ============================================
# 上传目录（可选：未设置时自动使用 ./uploads）
# UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760  # 10MB

# ============================================
# 向量化模型配置
# ============================================
EMBEDDING_MODEL="openai/text-embedding-v4"
VECTOR_SIZE=1024

# DashScope API配置（阿里百炼，兼容OpenAI接口）
EMBEDDING_API_BASE="https://dashscope.aliyuncs.com/compatible-mode/v1"
# DASHSCOPE_API_KEY="your-dashscope-api-key"

# 或使用 OpenAI API
OPENAI_API_KEY="your-openai-api-key"

# ============================================
# 日志配置
# ============================================
LOG_LEVEL="INFO"
# 日志文件路径（可选：未设置时自动使用 ./logs/）
# LOG_FILE="./logs/app.log"
# LLM_LOG_FILE="./logs/llm.log"

# ============================================
# 数据库配置
# ============================================
# MySQL 连接配置
DATABASE_URL="mysql+pymysql://root:password@127.0.0.1:3306/personal_knowledgebase"
DATABASE_ECHO=false

# ============================================
# LLM 大语言模型配置
# ============================================
# 使用 DeepSeek（推荐，性价比高）
LLM_API_BASE="https://api.deepseek.com/v1"
LLM_API_KEY="your-deepseek-api-key"
LLM_MODEL="deepseek-chat"

# 或使用其他兼容 OpenAI 的服务
# LLM_API_BASE="https://api.openai.com/v1"
# LLM_API_KEY="your-openai-api-key"
# LLM_MODEL="gpt-3.5-turbo"

LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=8192

# ============================================
# HuggingFace 配置
# ============================================
# 使用国内镜像加速下载
HF_ENDPOINT="https://hf-mirror.com"
HF_HOME="./huggingface_cache"
FASTEMBED_CACHE_PATH="./huggingface_cache"

# ============================================
# 稀疏向量配置（BM42）
# ============================================
SPARSE_EMBEDDING_MODEL="Qdrant/bm42-all-minilm-l6-v2-attentions"
SPARSE_VECTOR_NAME="bm42"

# ============================================
# Rerank 重排序配置
# ============================================
USE_RERANK=true
RERANK_MODEL="qwen3-rerank"  # 通义千问 Rerank
RERANK_TOP_N=5               # Rerank后返回的结果数
RETRIEVAL_TOP_K=20           # 初始检索的候选数

# ============================================
# 邮件服务配置（企业微信邮箱）
# ============================================
SMTP_HOST="smtp.exmail.qq.com"
SMTP_PORT=465
SMTP_USERNAME="your-email@company.com"
SMTP_PASSWORD="your-email-password"
SMTP_USE_TLS=false

# ============================================
# 短信服务配置（阿里云，可选）
# ============================================
# SMS_ACCESS_KEY_ID="your-access-key-id"
# SMS_ACCESS_KEY_SECRET="your-access-key-secret"
# SMS_SIGN_NAME="your-sms-sign"
# SMS_TEMPLATE_CODE="your-template-code"
# SMS_REGION="cn-hangzhou"
