# ============================================
# Memora 生产环境配置
# ============================================
# 此文件用于 Docker Compose 部署
# 重要：请根据实际情况修改密码和 API 密钥
# ============================================

# ============================================
# 应用配置
# ============================================
APP_NAME="Memora - 个人知识库系统"
APP_VERSION="0.2.0"
DEBUG=false

# ============================================
# Qdrant 向量数据库配置
# ============================================
QDRANT_HOST="qdrant"  # Docker内部服务名
QDRANT_PORT=6334
QDRANT_COLLECTION_NAME="central_library"
QDRANT_API_KEY=""
QDRANT_DEFAULT_LIMIT=5

# ============================================
# JWT 认证配置
# ============================================
# 重要：生产环境必须修改为强密钥！
SECRET_KEY="your-production-secret-key-change-this-immediately"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# 文件上传配置
# ============================================
MAX_FILE_SIZE=10485760  # 10MB

# ============================================
# 向量化模型配置
# ============================================
EMBEDDING_MODEL="openai/text-embedding-v4"
VECTOR_SIZE=1024

# DashScope API配置（阿里百炼，兼容OpenAI接口）
EMBEDDING_API_BASE="https://dashscope.aliyuncs.com/compatible-mode/v1"
DASHSCOPE_API_KEY="sk-ff813f1a3b664f449ea4916016330d39"
OPENAI_API_KEY="sk-ff813f1a3b664f449ea4916016330d39"

# ============================================
# 日志配置
# ============================================
LOG_LEVEL="INFO"

# ============================================
# 数据库配置
# ============================================
# MySQL 连接配置 (Docker内部网络)
DATABASE_URL="mysql+pymysql://root:memora_mysql_root_pass_2024@mysql:3306/personal_knowledgebase"
DATABASE_ECHO=false

# ============================================
# LLM 大语言模型配置
# ============================================
LLM_API_BASE="https://dashscope.aliyuncs.com/compatible-mode/v1"
LLM_API_KEY="sk-ff813f1a3b664f449ea4916016330d39"
LLM_MODEL="qwen-plus"
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=8192

# ============================================
# HuggingFace 配置
# ============================================
HF_ENDPOINT="https://hf-mirror.com"
HF_HOME="./huggingface_cache"
HF_HUB_OFFLINE=0
FASTEMBED_CACHE_PATH="./huggingface_cache"

# ============================================
# 稀疏向量配置（BM42）
# ============================================
SPARSE_EMBEDDING_MODEL="Qdrant/bm42-all-minilm-l6-v2-attentions"
SPARSE_VECTOR_NAME="bm42"

# ============================================
# Rerank 重排序配置
# ============================================
USE_RERANK=true
RERANK_MODEL="qwen3-rerank"
RERANK_TOP_N=5
RETRIEVAL_TOP_K=20

# ============================================
# 邮件服务配置（企业微信邮箱）
# ============================================
SMTP_HOST="smtp.exmail.qq.com"
SMTP_PORT=465
SMTP_USERNAME="your-email@company.com"
SMTP_PASSWORD="your-email-password"
SMTP_USE_TLS=false

# ============================================
# MySQL Root 密码
# ============================================
MYSQL_ROOT_PASSWORD=memora_mysql_root_pass_2024

# ============================================
# 知识图谱配置（Neo4j）
# ============================================
NEO4J_ENABLED=true
NEO4J_URI="bolt://neo4j:7687"  # Docker内部网络地址
NEO4J_USER="neo4j"
NEO4J_PASSWORD="memora_neo4j_pass"
NEO4J_DATABASE="neo4j"
KG_QUERY_MODE=mix

# ============================================
# Redis缓存配置
# ============================================
REDIS_ENABLED=true
REDIS_HOST="redis"  # Docker内部网络地址
REDIS_PORT=6379
REDIS_DB=0
REDIS_MAX_MEMORY="256mb"  # 最大内存
REDIS_PASSWORD=""  # 可选，生产环境建议设置

# ============================================
# MinerU 结构化解析配置
# ============================================
USE_MINERU=true                 # 启用 MinerU 解析器
MINERU_METHOD=auto              # auto/ocr/txt

# ============================================
# 多模态处理配置
# ============================================
VLM_ENABLED=true                # 启用 VLM 增强图片描述
VLM_API_BASE="https://dashscope.aliyuncs.com/compatible-mode/v1"
VLM_API_KEY="sk-ff813f1a3b664f449ea4916016330d39"
VLM_MODEL="qwen-vl-max"

# 多模态并发控制 (避免 API 限速)
MULTIMODAL_MAX_PARALLEL=2       # VLM/LLM 最大并发数
KG_ENTITY_MAX_PARALLEL=3        # 知识图谱实体提取最大并发数

# ============================================
# 上下文感知配置 (参照 RAG-Anything)
# ============================================
CONTEXT_WINDOW=1                # 上下文窗口大小 (page 模式=页数)
CONTEXT_MODE=page               # page/chunk
MAX_CONTEXT_TOKENS=2000         # 上下文最大字符数
CONTEXT_INCLUDE_HEADERS=true
CONTEXT_INCLUDE_CAPTIONS=true
CONTEXT_FILTER_CONTENT_TYPES=["text"]
