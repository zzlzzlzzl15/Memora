# ============================================
# Memora 单用户模式 - 环境变量配置
# 专为 OpenClaw Skills 设计
# ============================================

# ============================================
# 应用配置
# ============================================
APP_NAME="Memora知识库"
APP_VERSION="1.0.0"
DEBUG=false

# ============================================
# 数据库配置
# ============================================
# MySQL 连接配置
DATABASE_URL="mysql+pymysql://root:your_mysql_password@127.0.0.1:3306/personal_knowledgebase"
DATABASE_ECHO=false

# ============================================
# Qdrant 向量数据库配置
# ============================================
QDRANT_HOST="localhost"
QDRANT_PORT=6334
QDRANT_COLLECTION_NAME="knowledge_base"
QDRANT_API_KEY=""
QDRANT_DEFAULT_LIMIT=5
QDRANT_PREFER_GRPC=true

# ============================================
# JWT 配置（单用户模式下不再使用）
# ============================================
SECRET_KEY="single-user-mode-no-auth-required"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# 文件上传配置
# ============================================
MAX_FILE_SIZE=10485760  # 10MB

# ============================================
# 向量化模型配置
# ============================================
EMBEDDING_MODEL="openai/text-embedding-v4"
VECTOR_SIZE=1024

# DashScope API配置（阿里百炼）
EMBEDDING_API_BASE="https://dashscope.aliyuncs.com/compatible-mode/v1"
# DASHSCOPE_API_KEY="your-dashscope-api-key"

# 或使用 OpenAI API
OPENAI_API_KEY="your-openai-api-key"

# ============================================
# LLM 大语言模型配置
# ============================================
# DeepSeek（推荐，性价比高）
LLM_API_BASE="https://api.deepseek.com/v1"
LLM_API_KEY="your-deepseek-api-key"
LLM_MODEL="deepseek-chat"

LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=8192

# ============================================
# HuggingFace 配置
# ============================================
HF_ENDPOINT="https://hf-mirror.com"
HF_HOME="./huggingface_cache"
FASTEMBED_CACHE_PATH="./huggingface_cache"
HF_HUB_OFFLINE=1

# ============================================
# 稀疏向量配置（BM42）
# ============================================
SPARSE_EMBEDDING_MODEL="Qdrant/bm42-all-minilm-l6-v2-attentions"
SPARSE_VECTOR_NAME="bm42"

# ============================================
# Rerank 重排序配置
# ============================================
USE_RERANK=true
RERANK_MODEL="qwen3-rerank"
RERANK_TOP_N=5
RETRIEVAL_TOP_K=20

# ============================================
# 日志配置
# ============================================
LOG_LEVEL="INFO"
